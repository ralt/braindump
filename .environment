export DATABASE_URL="postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_PATH}?serverVersion=16&charset=utf8"

# Mercure — build Symfony-expected env vars from Upsun relationship vars
if [ -n "${MERCURE_HOST:-}" ]; then
  export MERCURE_URL="${MERCURE_SCHEME}://${MERCURE_HOST}:${MERCURE_PORT}/.well-known/mercure"
  export MERCURE_JWT_SECRET="${MERCURE_PASSWORD}"

  # Public URL: prepend "mercure." to the primary route host (matches routes config)
  if [ -n "${PLATFORM_ROUTES:-}" ]; then
    PRIMARY_HOST=$(echo "$PLATFORM_ROUTES" | base64 -d | python3 -c "
import sys, json
routes = json.load(sys.stdin)
for url, route in routes.items():
    if route.get('primary'):
        from urllib.parse import urlparse
        print(urlparse(url).hostname)
        break
")
    export MERCURE_PUBLIC_URL="https://mercure.${PRIMARY_HOST}/.well-known/mercure"
  fi
fi

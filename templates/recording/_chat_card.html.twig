<div class="card chat-card"
     {{ stimulus_controller('ai-chat', {
         sessionId: aiSession.id.toRfc4122,
         messagesUrl: path('api_ai_session_message', {id: aiSession.id}),
         mercureUrl: mercurePublicUrl ~ '?topic=' ~ ('ai-session/' ~ aiSession.id)|url_encode,
         autoFirstMessage: autoFirstMessage|default(''),
         clearUrl: path('api_ai_session_clear', {id: aiSession.id})
     }) }}>
    <div class="chat-header flex flex-between flex-center">
        <span>Rewriting assistant</span>
        <button type="button" class="btn btn-secondary btn-sm" {{ stimulus_action('ai-chat', 'clear') }}>Clear conversation</button>
    </div>
    <div class="chat-messages" {{ stimulus_target('ai-chat', 'messages') }}>
        {% for message in messages %}
            <div class="chat-bubble {{ message.role.value }}" data-message-id="{{ message.id.toRfc4122 }}">
                <div class="chat-bubble-role">{{ message.role.value }}</div>
                <div class="chat-bubble-body">{{ message.content }}</div>
            </div>
        {% endfor %}
    </div>
    <form class="chat-input-bar"
          {{ stimulus_controller('chat-mic', {
              transcribeUrl: path('api_transcribe'),
              maxSeconds: 30
          }) }}
          {{ stimulus_action('ai-chat', 'send', 'submit') }}>
        <select class="chat-mic-device"
                title="Microphone"
                {{ stimulus_target('chat-mic', 'device') }}
                {{ stimulus_action('chat-mic', 'onDeviceChange', 'change') }}></select>
        <button type="button" class="chat-mic-btn"
                title="Record voice (max 30s)"
                {{ stimulus_target('chat-mic', 'button') }}
                {{ stimulus_action('chat-mic', 'toggle') }}>🎤</button>
        <textarea {{ stimulus_target('ai-chat', 'input') }}
                  {{ stimulus_target('chat-mic', 'output') }}
                  rows="1"
                  placeholder="Ask the assistant to rewrite, edit, summarize..."></textarea>
        <button type="submit" class="chat-send-btn" {{ stimulus_target('ai-chat', 'send') }}>Send</button>
    </form>
</div>

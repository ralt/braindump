{% if recording.status.value == 'completed' and recording.transcription %}
    {% if not aiSession %}
        <div class="card transcript-card">
            <h2 class="mb-1">Transcription</h2>
            <div class="transcription-text">{{ recording.transcription }}</div>
        </div>

        {% if aiAvailable %}
            <div class="card chat-start-card"
                 {{ stimulus_controller('chat-starter', {
                     startUrl: path('api_ai_chat_start', {id: recording.id})
                 }) }}>
                <p class="text-muted mb-1">Start a writing session with this transcript and ask the AI to rewrite, tighten, or restructure it.</p>
                <button type="button" class="btn btn-primary"
                        {{ stimulus_target('chat-starter', 'button') }}
                        {{ stimulus_action('chat-starter', 'start') }}>Start AI chat</button>
            </div>
        {% endif %}
    {% else %}
        {{ include('recording/_chat_card.html.twig', {
            aiSession: aiSession,
            messages: aiSession.messages,
            autoFirstMessage: autoFirstMessage,
            skills: skills|default([]),
            activeSkillIds: activeSkillIds|default([]),
        }) }}
    {% endif %}
{% elseif recording.status.value == 'failed' %}
    <div class="card">
        <div class="alert alert-error">
            <strong>Transcription failed:</strong> {{ recording.errorMessage }}
        </div>
        {% if is_granted('RECORDING_EDIT', recording) %}
            <form method="post" action="{{ path('api_recording_retry', {id: recording.id}) }}" class="mt-1">
                <input type="hidden" name="_token" value="{{ csrf_token('retry') }}">
                <button type="submit" class="btn btn-primary">Retry Transcription</button>
            </form>
        {% endif %}
    </div>
{% elseif recording.status.value in ['pending', 'transcribing'] %}
    <div class="card">
        <p class="text-muted text-center p-section">Transcription in progress...</p>
    </div>
{% endif %}

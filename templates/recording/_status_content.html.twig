{% if recording.status.value == 'completed' and recording.transcription %}
    {% if not aiSession %}
        <div class="card transcript-card" {{ stimulus_controller('clipboard') }}>
            <div class="flex flex-between flex-center mb-1">
                <h2>Transcription</h2>
                <button type="button" class="btn btn-secondary btn-sm"
                        {{ stimulus_target('clipboard', 'button') }}
                        {{ stimulus_action('clipboard', 'copy') }}>Copy</button>
            </div>
            <div class="transcription-text" {{ stimulus_target('clipboard', 'source') }}>{{ recording.transcription }}</div>
        </div>

        {% if aiAvailable %}
            <div class="card chat-start-card"
                 {{ stimulus_controller('chat-starter', {
                     startUrl: path('api_ai_chat_start', {id: recording.id})
                 }) }}>
                <p class="text-muted mb-1">Start a writing session with this transcript and ask the AI to rewrite, tighten, or restructure it.</p>
                {% if skills|default([]) is not empty %}
                    <div class="chat-start-skills">
                        <button type="button" class="chat-start-skills-toggle"
                                {{ stimulus_target('chat-starter', 'toggle') }}
                                {{ stimulus_action('chat-starter', 'toggleSkills') }}>
                            Skills<span class="chat-skills-count" {{ stimulus_target('chat-starter', 'count') }}></span>
                        </button>
                        <div class="chat-start-skills-panel hidden" {{ stimulus_target('chat-starter', 'panel') }}>
                            {% for skill in skills %}
                                <label class="chat-skill-row">
                                    <input type="checkbox"
                                           value="{{ skill.id }}"
                                           {{ stimulus_target('chat-starter', 'skill') }}
                                           {{ stimulus_action('chat-starter', 'refreshCount', 'change') }}>
                                    <span class="chat-skill-name">{{ skill.name }}</span>
                                </label>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
                <button type="button" class="btn btn-primary"
                        {{ stimulus_target('chat-starter', 'button') }}
                        {{ stimulus_action('chat-starter', 'start') }}>Start AI chat</button>
            </div>
        {% endif %}
    {% else %}
        {{ include('recording/_chat_card.html.twig', {
            aiSession: aiSession,
            messages: aiSession.messages,
            autoFirstMessage: autoFirstMessage,
            skills: skills|default([]),
            activeSkillIds: activeSkillIds|default([]),
        }) }}
    {% endif %}
{% elseif recording.status.value == 'failed' %}
    <div class="card">
        <div class="alert alert-error">
            <strong>Transcription failed:</strong> {{ recording.errorMessage }}
        </div>
        {% if is_granted('RECORDING_EDIT', recording) %}
            <form method="post" action="{{ path('api_recording_retry', {id: recording.id}) }}" class="mt-1">
                <input type="hidden" name="_token" value="{{ csrf_token('retry') }}">
                <button type="submit" class="btn btn-primary">Retry Transcription</button>
            </form>
        {% endif %}
        {% if audioAvailable|default(false) %}
            <p class="text-muted mt-1">The audio is kept while this recording is unresolved — download it from the header to process it elsewhere.</p>
        {% endif %}
    </div>
{% elseif recording.status.value in ['pending', 'transcribing'] %}
    <div class="card">
        <p class="text-muted text-center p-section">Transcription in progress...</p>
    </div>
{% endif %}

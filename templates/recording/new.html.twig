{% extends 'base.html.twig' %}

{% block title %}New Recording - Braindump{% endblock %}

{% block body %}
    <h1 class="mb-2">New Recording</h1>

    {# Only worth saying when it's about to bite. Reaching this by talking is not possible, so
       seeing it at all means something automated has been uploading. #}
    {% if dailyRemainingSeconds is defined and dailyRemainingSeconds < 3600 %}
        <div class="alert alert-warning">
            {% if dailyRemainingSeconds <= 0 %}
                You've hit the 24-hour daily upload limit. Recording still works, but the upload
                will be refused until your earlier recordings age out of the last 24 hours.
            {% else %}
                About {{ (dailyRemainingSeconds / 60)|round }} minutes left of your 24-hour daily
                upload limit.
            {% endif %}
        </div>
    {% endif %}

    <div class="card" {{ stimulus_controller('audio-recorder', {
        uploadUrl: path('api_recording_upload'),
        maxFileSize: 24 * 1024 * 1024
    }) }}>
        <div class="form-group">
            <label for="title">Title</label>
            <input type="text" id="title" placeholder="Give your recording a name..." {{ stimulus_target('audio-recorder', 'title') }}>
        </div>

        <div class="form-group">
            <label for="microphone">Microphone</label>
            <select id="microphone" {{ stimulus_target('audio-recorder', 'microphone') }}>
                <option value="">Loading microphones...</option>
            </select>
        </div>

        <div class="flex gap-1 mb-1">
            <button class="btn btn-primary" {{ stimulus_action('audio-recorder', 'start') }} {{ stimulus_target('audio-recorder', 'startBtn') }}>Record</button>
            <button class="btn btn-secondary" {{ stimulus_action('audio-recorder', 'togglePause') }} {{ stimulus_target('audio-recorder', 'pauseBtn') }} aria-pressed="false" disabled>Pause</button>
            <button class="btn btn-danger" {{ stimulus_action('audio-recorder', 'stop') }} {{ stimulus_target('audio-recorder', 'stopBtn') }} disabled>Stop</button>
        </div>

        <canvas {{ stimulus_target('audio-recorder', 'waveform') }} class="waveform-canvas hidden"></canvas>

        <div {{ stimulus_target('audio-recorder', 'status') }} class="alert hidden">
            <span {{ stimulus_target('audio-recorder', 'timer') }}>00:00</span>
            <span {{ stimulus_target('audio-recorder', 'fileSize') }}></span>
        </div>

        <div {{ stimulus_target('audio-recorder', 'sizeWarning') }} class="alert alert-warning hidden">
            Approaching recording limit — consider wrapping up soon.
        </div>

        <div {{ stimulus_target('audio-recorder', 'sizeWarningUrgent') }} class="alert alert-warning-urgent hidden">
            Almost at recording limit — recording will stop soon.
        </div>

        <div {{ stimulus_target('audio-recorder', 'uploadStatus') }} class="alert alert-success hidden"></div>
    </div>
{% endblock %}

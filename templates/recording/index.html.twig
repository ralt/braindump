{% extends 'base.html.twig' %}

{% block title %}Recordings - Braindump{% endblock %}

{% block body %}
    <div class="flex flex-between flex-center mb-1">
        <h1>Recordings</h1>
        <a href="{{ path('app_recording_new') }}" class="btn btn-primary">New Recording</a>
    </div>

    <div class="card mb-1">
        <form method="get" action="{{ path('app_recording_index') }}" class="flex gap-1" {{ stimulus_controller('auto-search') }} data-turbo-frame="search-results">
            <input type="text" name="q" value="{{ query }}" placeholder="Search recordings..." class="input-inline" {{ stimulus_target('auto-search', 'input') }} {{ stimulus_action('auto-search', 'search', 'input') }}>
            <button type="submit" class="btn btn-primary">Search</button>
            {% if query %}
                <a href="{{ path('app_recording_index') }}" class="btn btn-secondary" data-turbo-frame="search-results">Clear</a>
            {% endif %}
        </form>
    </div>

    <turbo-frame id="search-results" data-turbo-action="advance">
    {% if recordings is empty %}
        <div class="card empty-state">
            <p class="text-muted">No recordings yet.</p>
            <a href="{{ path('app_recording_new') }}" class="btn btn-primary mt-1" data-turbo-frame="_top">Create your first recording</a>
        </div>
    {% else %}
        <div class="card card-flush">
            <table>
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Status</th>
                        <th>Owner</th>
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for recording in recordings %}
                        <tr>
                            <td><a href="{{ path('app_recording_show', {id: recording.id}) }}" data-turbo-frame="_top">{{ recording.title ?: 'Untitled' }}</a></td>
                            <td><span class="badge badge-{{ recording.status.value }}">{{ recording.status.value }}</span></td>
                            <td class="text-muted">{{ recording.owner.displayName }}</td>
                            <td class="text-muted">{{ recording.createdAt|date('Y-m-d H:i') }}</td>
                            <td><a href="{{ path('app_recording_show', {id: recording.id}) }}" class="btn btn-secondary btn-sm" data-turbo-frame="_top">View</a></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
    </turbo-frame>
{% endblock %}

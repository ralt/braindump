{% extends 'base.html.twig' %}

{% block title %}Recordings - Braindump{% endblock %}

{% block body %}
    <div class="flex flex-between flex-center mb-1">
        <h1>Recordings</h1>
        <a href="{{ path('app_recording_new') }}" class="btn btn-primary">New Recording</a>
    </div>

    <div class="card mb-1">
        <form method="get" action="{{ path('app_recording_index') }}" class="flex gap-1">
            <input type="text" name="q" value="{{ query }}" placeholder="Search recordings..."
                   style="flex: 1; padding: 0.5rem 0.75rem; border: 1px solid #d1d5db; border-radius: 8px; font-size: 0.875rem;">
            <button type="submit" class="btn btn-primary">Search</button>
            {% if query %}
                <a href="{{ path('app_recording_index') }}" class="btn btn-secondary">Clear</a>
            {% endif %}
        </form>
    </div>

    {% if recordings is empty %}
        <div class="card" style="text-align: center; padding: 3rem 1.5rem;">
            <p class="text-muted">No recordings yet.</p>
            <a href="{{ path('app_recording_new') }}" class="btn btn-primary" style="margin-top: 1rem;">Create your first recording</a>
        </div>
    {% else %}
        <div class="card" style="padding: 0; overflow: hidden;">
            <table>
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Status</th>
                        <th>Owner</th>
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for recording in recordings %}
                        <tr>
                            <td><a href="{{ path('app_recording_show', {id: recording.id}) }}">{{ recording.title }}</a></td>
                            <td><span class="badge badge-{{ recording.status.value }}">{{ recording.status.value }}</span></td>
                            <td style="color: #6b7280;">{{ recording.owner.displayName }}</td>
                            <td style="color: #6b7280;">{{ recording.createdAt|date('Y-m-d H:i') }}</td>
                            <td><a href="{{ path('app_recording_show', {id: recording.id}) }}" class="btn btn-secondary btn-sm">View</a></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}

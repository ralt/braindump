{% extends 'base.html.twig' %}

{% block title %}AI Session - {{ recording.title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .terminal-container {
            background: #111;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #e5e7eb;
        }
        .terminal-header {
            background: #fafafa;
            border-bottom: 1px solid #e5e7eb;
            padding: 0.625rem 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.85rem;
        }
        .terminal-header .title { font-weight: 600; color: #111; }
        #terminal {
            height: 70vh;
            padding: 0.5rem;
        }
    </style>
{% endblock %}

{% block body %}
    <div {{ stimulus_controller('ai-terminal', {
        recordingId: recording.id.toRfc4122,
        startUrl: path('api_ai_session_start', {id: recording.id}),
        mercureUrl: mercurePublicUrl ~ '?topic=',
    }) }}>
        <div class="terminal-container">
            <div class="terminal-header">
                <span class="title">pi.dev - {{ recording.title }}</span>
                <div class="flex gap-1 flex-center">
                    <span class="badge badge-transcribing" {{ stimulus_target('ai-terminal', 'status') }}>Connecting...</span>
                    <button class="btn btn-danger btn-sm" {{ stimulus_target('ai-terminal', 'closeBtn') }} {{ stimulus_action('ai-terminal', 'close') }}>Close</button>
                    <a href="{{ path('app_recording_show', {id: recording.id}) }}" class="btn btn-secondary btn-sm">Back</a>
                </div>
            </div>
            <div id="terminal" {{ stimulus_target('ai-terminal', 'terminal') }}></div>
        </div>
    </div>
{% endblock %}

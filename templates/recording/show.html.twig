{% extends 'base.html.twig' %}

{% block title %}{{ recording.displayTitle }} - Braindump{% endblock %}

{% block body %}
    <div {{ stimulus_controller('recording-status', {
        statusUrl: path('api_recording_status', {id: recording.id}),
        contentUrl: path('app_recording_status_content', {id: recording.id}),
        status: recording.status.value,
        mercureUrl: recording.status.value in ['pending', 'transcribing'] ? mercurePublicUrl ~ '?topic=' ~ ('recording/' ~ recording.id)|url_encode : ''
    }) }}>
    <div class="flex flex-between flex-center mb-1">
        <h1 {{ stimulus_target('recording-status', 'title') }}>{{ recording.displayTitle }}</h1>
        <div class="flex gap-1">
            <span class="badge badge-{{ recording.status.value }}" {{ stimulus_target('recording-status', 'badge') }}>{{ recording.status.value }}</span>

            {% if is_granted('RECORDING_DELETE', recording) %}
                <form method="post" action="{{ path('api_recording_delete', {id: recording.id}) }}" onsubmit="return confirm('Delete this recording? This cannot be undone.')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-recording') }}">
                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
            {% endif %}
        </div>
    </div>

    <div class="card">
        <div class="flex gap-1 flex-wrap meta-info">
            <span>{{ recording.owner.displayName }}</span>
            <span class="gap-separator">|</span>
            <span>{{ recording.createdAt|date('Y-m-d H:i') }}</span>
            <span class="gap-separator">|</span>
            <span>{{ (recording.fileSizeBytes / 1024 / 1024)|number_format(1) }} MB</span>
        </div>
    </div>

    <div {{ stimulus_target('recording-status', 'content') }}>
        {{ include('recording/_status_content.html.twig') }}
    </div>
    </div>
{% endblock %}

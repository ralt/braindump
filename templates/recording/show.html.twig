{% extends 'base.html.twig' %}

{% block title %}{{ recording.displayTitle }} - Braindump{% endblock %}

{% block body %}
    <div {{ stimulus_controller('recording-status', {
        statusUrl: path('api_recording_status', {id: recording.id}),
        contentUrl: path('app_recording_status_content', {id: recording.id}),
        status: recording.status.value,
        mercureUrl: recording.status.value in ['pending', 'transcribing'] ? mercurePublicUrl ~ '?topic=' ~ ('recording/' ~ recording.id)|url_encode : ''
    }) }}>
    <div class="flex flex-between flex-center mb-1">
        <h1 {{ stimulus_target('recording-status', 'title') }}>{{ recording.displayTitle }}</h1>
        <div class="flex gap-1">
            <span class="badge badge-{{ recording.status.value }}" {{ stimulus_target('recording-status', 'badge') }}>{{ recording.status.value }}</span>

            {% if audioAvailable %}
                <a class="btn btn-secondary btn-sm"
                   href="{{ path('app_recording_audio', {id: recording.id}) }}"
                   {{ stimulus_target('recording-status', 'audioOnly') }}>Download audio</a>
            {% endif %}

            {% if is_granted('RECORDING_DELETE', recording) %}
                {% embed '_confirm_dialog.html.twig' with {
                    trigger: 'Delete',
                    title: 'Delete this recording?',
                    message: 'The transcript and any AI sessions on it are removed too. This cannot be undone.',
                } %}
                    {% block confirm %}
                        <form method="post" action="{{ path('api_recording_delete', {id: recording.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-recording') }}">
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                    {% endblock %}
                {% endembed %}
            {% endif %}
        </div>
    </div>

    <div class="card">
        <div class="flex gap-1 flex-wrap meta-info">
            <span>{{ recording.owner.displayName }}</span>
            <span class="gap-separator">|</span>
            <span>{{ recording.createdAt|date('Y-m-d H:i') }}</span>
            {% if recording.durationLabel %}
                <span class="gap-separator">|</span>
                <span>{{ recording.durationLabel }}</span>
            {% endif %}
            {# Only meaningful while the file exists — once transcribed it's deleted, and the
               size of something you can't download tells you nothing. Tagged audioOnly so it
               disappears with the download button when a transcription finishes in this tab. #}
            {% if audioAvailable %}
                <span class="gap-separator" {{ stimulus_target('recording-status', 'audioOnly') }}>|</span>
                <span {{ stimulus_target('recording-status', 'audioOnly') }}>{{ (recording.fileSizeBytes / 1024 / 1024)|number_format(1) }} MB</span>
            {% endif %}
        </div>
    </div>

    <div {{ stimulus_target('recording-status', 'content') }}>
        {{ include('recording/_status_content.html.twig') }}
    </div>
    </div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}{{ recording.title }} - Braindump{% endblock %}

{% block body %}
    <div {{ stimulus_controller('recording-status', {
        statusUrl: path('api_recording_status', {id: recording.id}),
        status: recording.status.value,
        mercureUrl: recording.status.value in ['pending', 'transcribing'] ? mercurePublicUrl ~ '?topic=' ~ ('recording/' ~ recording.id)|url_encode : ''
    }) }}>
    <div class="flex flex-between flex-center mb-1">
        <h1>{{ recording.title }}</h1>
        <div class="flex gap-1">
            <span class="badge badge-{{ recording.status.value }}" {{ stimulus_target('recording-status', 'badge') }}>{{ recording.status.value }}</span>

            {% if is_granted('RECORDING_SHARE', recording) %}
                <button class="btn btn-secondary btn-sm" {{ stimulus_action('share-modal', 'open') }}>Share</button>
            {% endif %}

            {% if is_granted('RECORDING_DELETE', recording) %}
                <form method="post" action="{{ path('api_recording_delete', {id: recording.id}) }}" onsubmit="return confirm('Delete this recording? This cannot be undone.')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-recording') }}">
                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
            {% endif %}
        </div>
    </div>

    <div class="card">
        <div class="flex gap-1 flex-wrap meta-info">
            <span>{{ recording.owner.displayName }}</span>
            <span class="gap-separator">|</span>
            <span>{{ recording.createdAt|date('Y-m-d H:i') }}</span>
            <span class="gap-separator">|</span>
            <span>{{ (recording.fileSizeBytes / 1024 / 1024)|number_format(1) }} MB</span>
        </div>
    </div>

    {% if recording.status.value == 'completed' and recording.transcription %}
        {% if not aiSession %}
            <div class="card">
                <h2 class="mb-1">Transcription</h2>
                <div class="transcription-text">{{ recording.transcription }}</div>
            </div>
        {% endif %}

        {% if aiSession %}
            <div class="card chat-card"
                 {{ stimulus_controller('ai-chat', {
                     sessionId: aiSession.id.toRfc4122,
                     messagesUrl: path('api_ai_session_message', {id: aiSession.id}),
                     mercureUrl: mercurePublicUrl ~ '?topic=' ~ ('ai-session/' ~ aiSession.id)|url_encode,
                     autoFirstMessage: autoFirstMessage|default(''),
                     clearUrl: path('api_ai_session_clear', {id: aiSession.id})
                 }) }}>
                <div class="chat-header flex flex-between flex-center">
                    <span>Rewriting assistant</span>
                    <button type="button" class="btn btn-secondary btn-sm" {{ stimulus_action('ai-chat', 'clear') }}>Clear conversation</button>
                </div>
                <div class="chat-messages" {{ stimulus_target('ai-chat', 'messages') }}>
                    {% for message in aiSession.messages %}
                        <div class="chat-bubble {{ message.role.value }}" data-message-id="{{ message.id.toRfc4122 }}">
                            <div class="chat-bubble-role">{{ message.role.value }}</div>
                            <div class="chat-bubble-body">{{ message.content }}</div>
                        </div>
                    {% endfor %}
                </div>
                <form class="chat-input-bar"
                      {{ stimulus_controller('chat-mic', {
                          transcribeUrl: path('api_transcribe'),
                          maxSeconds: 30
                      }) }}
                      {{ stimulus_action('ai-chat', 'send', 'submit') }}>
                    <select class="chat-mic-device"
                            title="Microphone"
                            {{ stimulus_target('chat-mic', 'device') }}
                            {{ stimulus_action('chat-mic', 'onDeviceChange', 'change') }}></select>
                    <button type="button" class="chat-mic-btn"
                            title="Record voice (max 30s)"
                            {{ stimulus_target('chat-mic', 'button') }}
                            {{ stimulus_action('chat-mic', 'toggle') }}>🎤</button>
                    <textarea {{ stimulus_target('ai-chat', 'input') }}
                              {{ stimulus_target('chat-mic', 'output') }}
                              rows="1"
                              placeholder="Ask the assistant to rewrite, edit, summarize..."></textarea>
                    <button type="submit" class="chat-send-btn" {{ stimulus_target('ai-chat', 'send') }}>Send</button>
                </form>
            </div>
        {% endif %}
    {% elseif recording.status.value == 'failed' %}
        <div class="card">
            <div class="alert alert-error">
                <strong>Transcription failed:</strong> {{ recording.errorMessage }}
            </div>
            {% if is_granted('RECORDING_EDIT', recording) %}
                <form method="post" action="{{ path('api_recording_retry', {id: recording.id}) }}" class="mt-1">
                    <input type="hidden" name="_token" value="{{ csrf_token('retry') }}">
                    <button type="submit" class="btn btn-primary">Retry Transcription</button>
                </form>
            {% endif %}
        </div>
    {% elseif recording.status.value in ['pending', 'transcribing'] %}
        <div class="card" {{ stimulus_target('recording-status', 'transcriptionArea') }}>
            <p class="text-muted text-center p-section">Transcription in progress...</p>
        </div>
    {% endif %}

    {% if recording.shares|length > 0 %}
        <div class="card card-flush">
            <div class="card-section">
                <h3>Shared with</h3>
            </div>
            <table class="mt-1">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Permission</th>
                        {% if is_granted('RECORDING_SHARE', recording) %}
                            <th></th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for share in recording.shares %}
                        <tr>
                            <td>{{ share.sharedWith.displayName }} <span class="text-muted">({{ share.sharedWith.email }})</span></td>
                            <td><span class="badge badge-completed">{{ share.permission.value }}</span></td>
                            {% if is_granted('RECORDING_SHARE', recording) %}
                                <td>
                                    <form method="post" action="{{ path('api_recording_unshare', {id: recording.id, userId: share.sharedWith.id}) }}" class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('unshare') }}">
                                        <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                                    </form>
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {% if is_granted('RECORDING_SHARE', recording) %}
        <div class="card hidden" id="share-modal" {{ stimulus_controller('share-modal', {
            shareUrl: path('api_recording_share', {id: recording.id})
        }) }}>
            <h3 class="mb-1">Share Recording</h3>
            <form {{ stimulus_action('share-modal', 'submit', 'submit') }}>
                <div class="flex gap-1">
                    <input type="email" name="email" placeholder="User email..." class="input-inline" {{ stimulus_target('share-modal', 'email') }}>
                    <select name="permission" class="select-inline" {{ stimulus_target('share-modal', 'permission') }}>
                        <option value="view">View</option>
                        <option value="edit">Edit</option>
                    </select>
                    <button type="submit" class="btn btn-primary">Share</button>
                </div>
            </form>
            <div {{ stimulus_target('share-modal', 'message') }}></div>
        </div>
    {% endif %}
    </div>
{% endblock %}

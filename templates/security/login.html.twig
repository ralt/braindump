{% extends 'base.html.twig' %}

{% block title %}Login - Braindump{% endblock %}

{% block body %}
    <div class="login-wrapper">
        <div class="login-header">
            <h1>Braindump</h1>
            <p class="text-muted">Sign in to your account</p>
        </div>

        <div class="card">
            {% if error %}
                <div class="alert alert-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form method="post">
                <div class="form-group">
                    <label for="inputEmail">Email</label>
                    <input type="email" id="inputEmail" name="_username" value="{{ last_username }}" required autofocus placeholder="you@example.com">
                </div>
                <div class="form-group">
                    <label for="inputPassword">Password</label>
                    <input type="password" id="inputPassword" name="_password" required placeholder="Your password">
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit" class="btn btn-primary w-full justify-center">Sign in</button>
            </form>
        </div>
    </div>
{% endblock %}

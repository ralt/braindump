{% extends 'base.html.twig' %}

{% block title %}Login - Braindump{% endblock %}

{% block body %}
    <div style="max-width: 380px; margin: 6rem auto;">
        <div style="text-align: center; margin-bottom: 2rem;">
            <h1 style="font-size: 1.75rem;">Braindump</h1>
            <p class="text-muted">Sign in to your account</p>
        </div>

        <div class="card">
            {% if error %}
                <div class="alert alert-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form method="post">
                <div class="form-group">
                    <label for="inputEmail">Email</label>
                    <input type="email" id="inputEmail" name="_username" value="{{ last_username }}" required autofocus placeholder="you@example.com">
                </div>
                <div class="form-group">
                    <label for="inputPassword">Password</label>
                    <input type="password" id="inputPassword" name="_password" required placeholder="Your password">
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">Sign in</button>
            </form>
        </div>
    </div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Settings - Braindump{% endblock %}

{% block body %}
    <h1 class="mb-2">Settings</h1>

    <div class="card">
        <h2 class="mb-1">Claude API Key</h2>
        <p class="text-muted mb-1">Enter your Anthropic API key to use Claude Code sessions. Your key is stored encrypted.</p>

        <form method="post">
            <div class="form-group">
                <label for="anthropic_api_key">Anthropic API Key</label>
                <input type="password" id="anthropic_api_key" name="anthropic_api_key"
                       placeholder="{% if hasApiKey %}Key is set (enter new value to replace){% else %}sk-ant-...{% endif %}">
            </div>
            {% if hasApiKey %}
                <p class="text-success mb-1">An API key is currently configured. Submit an empty value to remove it.</p>
            {% endif %}
            <button type="submit" class="btn btn-primary">Save</button>
        </form>
    </div>
{% endblock %}

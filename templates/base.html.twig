<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Braindump{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🧠</text></svg>">
        {% block stylesheets %}
            <style>
                :root {
                    --bg: #f6f6f9;
                    --surface: #ffffff;
                    --accent: #4361ee;
                    --accent-hover: #3a56d4;
                    --text: #1a1a2e;
                    --text-muted: #4e4e66;
                    --text-secondary: #374151;
                    --border: #e0e0e8;
                    --border-light: #f0f0f4;
                    --glow: rgba(67,97,238,.06);
                    --danger: #ef4444;
                    --danger-bg: #fef2f2;
                    --danger-border: #fecaca;
                    --success-bg: #f0fdf4;
                    --success-text: #166534;
                    --success-border: #bbf7d0;
                    --warning-bg: #fef9c3;
                    --warning-text: #854d0e;
                    --warning-border: #fde68a;
                    --warning-urgent-bg: #ffedd5;
                    --warning-urgent-text: #9a3412;
                    --warning-urgent-border: #fdba74;
                    --badge-pending-bg: #fef9c3;
                    --badge-pending-text: #854d0e;
                    --badge-transcribing-bg: #dbeafe;
                    --badge-transcribing-text: #1e40af;
                    --badge-completed-bg: #dcfce7;
                    --badge-completed-text: #166534;
                    --badge-failed-bg: #fef2f2;
                    --badge-failed-text: #991b1b;
                    --input-bg: #ffffff;
                    --hover-bg: rgba(67,97,238,.04);
                    --waveform-bg: #f0f0f4;
                }

                @media(prefers-color-scheme:dark) {
                    :root:not([data-theme="light"]) {
                        --bg: #0f0f1a;
                        --surface: #1a1a2e;
                        --accent: #6c84f7;
                        --accent-hover: #8da0ff;
                        --text: #e0e0e0;
                        --text-muted: #9a9ab0;
                        --text-secondary: #c0c0d0;
                        --border: #2a2a3e;
                        --border-light: #222236;
                        --glow: rgba(108,132,247,.08);
                        --danger: #f87171;
                        --danger-bg: #2a1a1a;
                        --danger-border: #5c2020;
                        --success-bg: #1a2a1a;
                        --success-text: #6ee7b7;
                        --success-border: #1e4030;
                        --warning-bg: #2a2510;
                        --warning-text: #fcd34d;
                        --warning-border: #4a3a10;
                        --warning-urgent-bg: #2a1e10;
                        --warning-urgent-text: #fdba74;
                        --warning-urgent-border: #5a3010;
                        --badge-pending-bg: #2a2510;
                        --badge-pending-text: #fcd34d;
                        --badge-transcribing-bg: #1a2040;
                        --badge-transcribing-text: #93b4f8;
                        --badge-completed-bg: #1a2a1a;
                        --badge-completed-text: #6ee7b7;
                        --badge-failed-bg: #2a1a1a;
                        --badge-failed-text: #fca5a5;
                        --input-bg: #1a1a2e;
                        --hover-bg: rgba(108,132,247,.06);
                        --waveform-bg: #1a1a2e;
                    }
                }

                :root[data-theme="dark"] {
                    --bg: #0f0f1a;
                    --surface: #1a1a2e;
                    --accent: #6c84f7;
                    --accent-hover: #8da0ff;
                    --text: #e0e0e0;
                    --text-muted: #9a9ab0;
                    --text-secondary: #c0c0d0;
                    --border: #2a2a3e;
                    --border-light: #222236;
                    --glow: rgba(108,132,247,.08);
                    --danger: #f87171;
                    --danger-bg: #2a1a1a;
                    --danger-border: #5c2020;
                    --success-bg: #1a2a1a;
                    --success-text: #6ee7b7;
                    --success-border: #1e4030;
                    --warning-bg: #2a2510;
                    --warning-text: #fcd34d;
                    --warning-border: #4a3a10;
                    --warning-urgent-bg: #2a1e10;
                    --warning-urgent-text: #fdba74;
                    --warning-urgent-border: #5a3010;
                    --badge-pending-bg: #2a2510;
                    --badge-pending-text: #fcd34d;
                    --badge-transcribing-bg: #1a2040;
                    --badge-transcribing-text: #93b4f8;
                    --badge-completed-bg: #1a2a1a;
                    --badge-completed-text: #6ee7b7;
                    --badge-failed-bg: #2a1a1a;
                    --badge-failed-text: #fca5a5;
                    --input-bg: #1a1a2e;
                    --hover-bg: rgba(108,132,247,.06);
                    --waveform-bg: #1a1a2e;
                }

                *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
                body {
                    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                    background: var(--bg);
                    color: var(--text);
                    line-height: 1.5;
                    -webkit-font-smoothing: antialiased;
                }

                /* Navbar */
                .navbar {
                    position: sticky;
                    top: 0;
                    z-index: 100;
                    background: var(--surface);
                    border-bottom: 1px solid var(--border);
                    padding: 0 1.5rem;
                    height: 56px;
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                }
                .navbar a { color: var(--text-muted); text-decoration: none; font-size: 0.875rem; font-weight: 500; transition: color 0.15s; }
                .navbar a:hover { color: var(--text); }
                .navbar .brand { color: var(--text); font-weight: 700; font-size: 1.125rem; letter-spacing: -0.025em; }
                .navbar .nav-links { display: flex; gap: 1.25rem; align-items: center; }

                .container { max-width: 960px; margin: 0 auto; padding: 2rem 1.5rem; }

                /* Buttons */
                .btn {
                    display: inline-flex;
                    align-items: center;
                    padding: 0.5rem 1rem;
                    border: none;
                    border-radius: 8px;
                    cursor: pointer;
                    font-size: 0.875rem;
                    font-weight: 500;
                    text-decoration: none;
                    transition: all 0.15s;
                }
                .btn-primary { background: var(--accent); color: #fff; }
                .btn-primary:hover { background: var(--accent-hover); box-shadow: 0 2px 8px var(--glow); }
                .btn-danger { background: var(--surface); color: var(--danger); border: 1px solid var(--danger-border); }
                .btn-danger:hover { background: var(--danger-bg); }
                .btn-secondary { background: var(--border-light); color: var(--text-secondary); }
                .btn-secondary:hover { background: var(--border); }
                .btn-sm { padding: 0.325rem 0.75rem; font-size: 0.8rem; }
                .btn:disabled, .btn.btn-disabled { opacity: 0.5; cursor: not-allowed; pointer-events: none; }

                /* Cards */
                .card {
                    background: var(--surface);
                    border: 1px solid var(--border);
                    border-radius: 12px;
                    padding: 1.5rem;
                    margin-bottom: 1rem;
                    transition: border-color 0.15s;
                }

                /* Forms */
                .form-group { margin-bottom: 1rem; }
                .form-group label { display: block; margin-bottom: 0.375rem; font-weight: 500; font-size: 0.875rem; color: var(--text-secondary); }
                .form-group input, .form-group select, .form-group textarea {
                    width: 100%;
                    padding: 0.5rem 0.75rem;
                    border: 1px solid var(--border);
                    border-radius: 8px;
                    font-size: 0.875rem;
                    color: var(--text);
                    background: var(--input-bg);
                    transition: border-color 0.15s;
                }
                .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
                    outline: none;
                    border-color: var(--accent);
                    box-shadow: 0 0 0 3px var(--glow);
                }

                /* Alerts */
                .alert { padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1rem; font-size: 0.875rem; }
                .alert-error { background: var(--danger-bg); color: var(--danger); border: 1px solid var(--danger-border); }
                .alert-success { background: var(--success-bg); color: var(--success-text); border: 1px solid var(--success-border); }
                .alert-warning { background: var(--warning-bg); color: var(--warning-text); border: 1px solid var(--warning-border); }
                .alert-warning-urgent { background: var(--warning-urgent-bg); color: var(--warning-urgent-text); border: 1px solid var(--warning-urgent-border); }

                /* Badges */
                .badge { display: inline-flex; align-items: center; padding: 0.2rem 0.625rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 500; }
                .badge-pending { background: var(--badge-pending-bg); color: var(--badge-pending-text); }
                .badge-transcribing { background: var(--badge-transcribing-bg); color: var(--badge-transcribing-text); }
                .badge-completed { background: var(--badge-completed-bg); color: var(--badge-completed-text); }
                .badge-failed { background: var(--badge-failed-bg); color: var(--badge-failed-text); }

                /* Tables */
                table { width: 100%; border-collapse: collapse; }
                table th, table td { padding: 0.75rem 1rem; text-align: left; }
                table th { font-weight: 500; font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--border); }
                table td { border-bottom: 1px solid var(--border-light); font-size: 0.875rem; }
                table tbody tr:hover { background: var(--hover-bg); }
                table td a { color: var(--accent); text-decoration: none; font-weight: 500; }
                table td a:hover { color: var(--accent-hover); }

                /* Page headings */
                h1 { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.025em; color: var(--text); }
                h2 { font-size: 1.125rem; font-weight: 600; color: var(--text); }
                h3 { font-size: 1rem; font-weight: 600; color: var(--text); }

                /* Utilities */
                .flex { display: flex; }
                .flex-between { justify-content: space-between; }
                .flex-center { align-items: center; }
                .flex-wrap { flex-wrap: wrap; }
                .gap-1 { gap: 0.5rem; }
                .gap-separator { color: var(--border); }
                .mb-1 { margin-bottom: 1rem; }
                .mb-2 { margin-bottom: 1.5rem; }
                .mt-1 { margin-top: 1rem; }
                .text-muted { color: var(--text-muted); font-size: 0.875rem; }
                .text-center { text-align: center; }
                .text-success { color: var(--success-text); font-size: 0.8rem; }
                .p-0 { padding: 0; }
                .p-section { padding: 3rem 1.5rem; }
                .overflow-hidden { overflow: hidden; }
                .w-full { width: 100%; }
                .justify-center { justify-content: center; }
                .inline { display: inline; }
                .hidden { display: none; }

                /* Layout components */
                .login-wrapper { max-width: 380px; margin: 6rem auto; }
                .login-header { text-align: center; margin-bottom: 2rem; }
                .login-header h1 { font-size: 1.75rem; }
                .login-divider { display: flex; align-items: center; gap: 1rem; margin: 1.25rem 0; color: var(--text-muted); font-size: 0.8rem; }
                .login-divider::before, .login-divider::after { content: ''; flex: 1; height: 1px; background: var(--border); }
                .empty-state { text-align: center; padding: 3rem 1.5rem; }
                .card-flush { padding: 0; overflow: hidden; }
                .card-section { padding: 1.5rem 1.5rem 0; }
                .input-inline {
                    flex: 1;
                    padding: 0.5rem 0.75rem;
                    border: 1px solid var(--border);
                    border-radius: 8px;
                    font-size: 0.875rem;
                    color: var(--text);
                    background: var(--input-bg);
                }
                .input-inline:focus {
                    outline: none;
                    border-color: var(--accent);
                    box-shadow: 0 0 0 3px var(--glow);
                }
                .select-inline {
                    padding: 0.5rem 0.75rem;
                    border: 1px solid var(--border);
                    border-radius: 8px;
                    font-size: 0.875rem;
                    color: var(--text);
                    background: var(--input-bg);
                }
                .nav-muted { color: var(--text-muted); }
                .meta-info { font-size: 0.875rem; color: var(--text-muted); }
                .transcription-text { white-space: pre-wrap; line-height: 1.7; font-size: 0.9375rem; color: var(--text-secondary); }

                /* Waveform */
                .waveform-canvas {
                    width: 100%;
                    height: 80px;
                    border-radius: 8px;
                    background: var(--waveform-bg);
                    margin-bottom: 1rem;
                }

                /* Theme toggle */
                .theme-toggle {
                    background: var(--surface);
                    border: 1px solid var(--border);
                    border-radius: 20px;
                    width: 40px;
                    height: 22px;
                    cursor: pointer;
                    padding: 2px;
                    transition: all 0.3s ease;
                    display: flex;
                    align-items: center;
                    flex-shrink: 0;
                }
                .theme-toggle:hover { border-color: var(--accent); }
                .theme-toggle .knob {
                    width: 16px;
                    height: 16px;
                    border-radius: 50%;
                    background: var(--accent);
                    transition: transform 0.3s ease;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                }
                .theme-toggle .knob svg {
                    width: 10px;
                    height: 10px;
                    color: var(--surface);
                }
                .theme-toggle[aria-checked="true"] .knob {
                    transform: translateX(18px);
                }

                /* Focus */
                :focus-visible {
                    outline: 2px solid var(--accent);
                    outline-offset: 2px;
                }

                /* Reduced motion */
                @media(prefers-reduced-motion:reduce) {
                    *, *::before, *::after { transition: none !important; }
                    .theme-toggle .knob { transition: none; }
                }

                /* AI chat */
                .chat-grid {
                    display: grid;
                    grid-template-columns: 240px 1fr;
                    gap: 1rem;
                    height: calc(100vh - 8rem);
                    min-height: 500px;
                }
                .chat-sidebar {
                    border: 1px solid var(--border);
                    border-radius: 12px;
                    padding: 0.75rem;
                    overflow-y: auto;
                    display: flex;
                    flex-direction: column;
                    gap: 0.5rem;
                    background: var(--surface);
                }
                .chat-sidebar h3 {
                    font-size: 0.75rem;
                    text-transform: uppercase;
                    letter-spacing: 0.05em;
                    color: var(--text-muted);
                    margin: 0 0 0.25rem 0;
                }
                .chat-session-link {
                    display: block;
                    padding: 0.5rem 0.625rem;
                    border-radius: 8px;
                    color: var(--text);
                    text-decoration: none;
                    font-size: 0.85rem;
                    border: 1px solid transparent;
                }
                .chat-session-link:hover {
                    background: var(--border-light);
                }
                .chat-session-link.active {
                    background: var(--hover-bg);
                    border-color: var(--accent);
                    color: var(--accent);
                    font-weight: 600;
                }
                .chat-session-meta {
                    display: block;
                    font-size: 0.7rem;
                    color: var(--text-muted);
                    margin-top: 0.125rem;
                }
                .chat-session-row {
                    display: flex;
                    align-items: stretch;
                    gap: 0.25rem;
                }
                .chat-session-row .chat-session-link { flex: 1; }
                .chat-session-delete {
                    background: transparent;
                    border: 1px solid transparent;
                    color: var(--text-muted);
                    border-radius: 8px;
                    padding: 0 0.5rem;
                    cursor: pointer;
                    font-size: 0.85rem;
                }
                .chat-session-delete:hover {
                    color: #b91c1c;
                    background: #fef2f2;
                    border-color: #fecaca;
                }
                .chat-main {
                    display: flex;
                    flex-direction: column;
                    border: 1px solid var(--border);
                    border-radius: 12px;
                    background: var(--surface);
                    overflow: hidden;
                }
                .chat-messages {
                    flex: 1;
                    overflow-y: auto;
                    padding: 1rem;
                    display: flex;
                    flex-direction: column;
                    gap: 0.75rem;
                }
                .chat-bubble {
                    max-width: 85%;
                    padding: 0.625rem 0.875rem;
                    border-radius: 12px;
                    font-size: 0.875rem;
                    line-height: 1.5;
                }
                .chat-bubble .chat-bubble-body {
                    word-wrap: break-word;
                }
                .chat-bubble.user .chat-bubble-body {
                    white-space: pre-wrap;
                }
                .chat-bubble.user {
                    align-self: flex-end;
                    background: var(--accent);
                    color: #fff;
                    border-bottom-right-radius: 4px;
                }
                .chat-bubble.assistant {
                    align-self: flex-start;
                    background: var(--border-light);
                    color: var(--text);
                    border-bottom-left-radius: 4px;
                }
                .chat-bubble.assistant .chat-bubble-body > :first-child { margin-top: 0; }
                .chat-bubble.assistant .chat-bubble-body > :last-child { margin-bottom: 0; }
                .chat-bubble.assistant p { margin: 0.5rem 0; }
                .chat-bubble.assistant ul,
                .chat-bubble.assistant ol { margin: 0.5rem 0; padding-left: 1.25rem; }
                .chat-bubble.assistant li { margin: 0.125rem 0; }
                .chat-bubble.assistant h1,
                .chat-bubble.assistant h2,
                .chat-bubble.assistant h3,
                .chat-bubble.assistant h4 { margin: 0.75rem 0 0.25rem; line-height: 1.3; }
                .chat-bubble.assistant h1 { font-size: 1.1rem; }
                .chat-bubble.assistant h2 { font-size: 1.05rem; }
                .chat-bubble.assistant h3 { font-size: 1rem; }
                .chat-bubble.assistant code {
                    background: rgba(0,0,0,0.06);
                    padding: 0.1rem 0.3rem;
                    border-radius: 4px;
                    font-size: 0.85em;
                    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                }
                .chat-bubble.assistant pre {
                    background: rgba(0,0,0,0.06);
                    padding: 0.625rem;
                    border-radius: 8px;
                    overflow-x: auto;
                    margin: 0.5rem 0;
                }
                .chat-bubble.assistant pre code {
                    background: transparent;
                    padding: 0;
                    font-size: 0.8rem;
                }
                .chat-bubble.assistant blockquote {
                    border-left: 3px solid var(--border);
                    margin: 0.5rem 0;
                    padding: 0 0.75rem;
                    color: var(--text-muted);
                }
                .chat-bubble.assistant a {
                    color: var(--accent);
                    text-decoration: underline;
                }
                .chat-bubble.assistant table {
                    border-collapse: collapse;
                    margin: 0.5rem 0;
                    font-size: 0.85em;
                }
                .chat-bubble.assistant th,
                .chat-bubble.assistant td {
                    border: 1px solid var(--border);
                    padding: 0.25rem 0.5rem;
                }
                .chat-bubble.error {
                    align-self: stretch;
                    background: #fef2f2;
                    color: #b91c1c;
                    border: 1px solid #fecaca;
                }
                .chat-bubble-role {
                    font-size: 0.7rem;
                    text-transform: uppercase;
                    letter-spacing: 0.05em;
                    opacity: 0.7;
                    margin-bottom: 0.25rem;
                }
                .chat-input-bar {
                    border-top: 1px solid var(--border);
                    padding: 0.75rem;
                    display: flex;
                    gap: 0.5rem;
                    align-items: flex-end;
                    background: var(--surface);
                }
                .chat-input-bar textarea {
                    flex: 1;
                    resize: none;
                    border: 1px solid var(--border);
                    border-radius: 8px;
                    padding: 0.5rem 0.625rem;
                    font: inherit;
                    font-size: 0.875rem;
                    background: var(--surface);
                    color: var(--text);
                    min-height: 2.5rem;
                    max-height: 10rem;
                }
                .chat-mic-device {
                    border-radius: 8px;
                    border: 1px solid var(--border);
                    background: var(--surface);
                    color: var(--text);
                    height: 2.5rem;
                    max-width: 10rem;
                    font-size: 0.8rem;
                    padding: 0 0.5rem;
                }
                .chat-mic-btn,
                .chat-send-btn {
                    border-radius: 8px;
                    border: 1px solid var(--border);
                    background: var(--surface);
                    color: var(--text);
                    width: 2.5rem;
                    height: 2.5rem;
                    cursor: pointer;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 1.1rem;
                }
                .chat-send-btn {
                    background: var(--accent);
                    color: #fff;
                    border-color: var(--accent);
                    width: auto;
                    padding: 0 1rem;
                    font-size: 0.875rem;
                    font-weight: 600;
                }
                .chat-send-btn:disabled,
                .chat-mic-btn:disabled {
                    opacity: 0.5;
                    cursor: not-allowed;
                }
                .chat-mic-btn.recording {
                    background: #ef4444;
                    color: #fff;
                    border-color: #ef4444;
                    animation: chat-mic-pulse 1.2s ease-in-out infinite;
                }
                @keyframes chat-mic-pulse {
                    0%, 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.5); }
                    50% { box-shadow: 0 0 0 8px rgba(239, 68, 68, 0); }
                }
                .chat-header {
                    padding: 0.75rem 1rem;
                    border-bottom: 1px solid var(--border);
                    font-size: 0.875rem;
                    color: var(--text-muted);
                }
                .chat-empty {
                    text-align: center;
                    color: var(--text-muted);
                    margin: auto;
                    font-size: 0.875rem;
                }
                .chat-new-btn { width: 100%; }
                .chat-start-card {
                    text-align: center;
                    padding: 1.5rem;
                    position: relative;
                }
                .chat-start-skills {
                    position: absolute;
                    top: 0.5rem;
                    right: 0.5rem;
                }
                .chat-start-skills-toggle {
                    background: none;
                    border: none;
                    padding: 0.25rem 0.5rem;
                    color: var(--text-muted);
                    font-size: 0.8rem;
                    cursor: pointer;
                    border-radius: 6px;
                }
                .chat-start-skills-toggle:hover {
                    color: var(--text);
                    background: var(--border-light);
                }
                .chat-start-skills-panel {
                    position: absolute;
                    top: calc(100% + 0.375rem);
                    right: 0;
                    z-index: 20;
                    width: 18rem;
                    max-height: 22rem;
                    overflow-y: auto;
                    text-align: left;
                    background: var(--surface);
                    border: 1px solid var(--border);
                    border-radius: 8px;
                    padding: 0.75rem;
                    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
                }

                /* Pagination */
                .pagination {
                    display: flex;
                    flex-direction: column;
                    gap: 0.5rem;
                    align-items: center;
                    margin: 1.5rem 0 0.5rem;
                }
                @media (min-width: 600px) {
                    .pagination {
                        flex-direction: row;
                        justify-content: space-between;
                    }
                }
                .pagination-summary {
                    font-size: 0.85rem;
                }
                .pagination-controls {
                    display: flex;
                    gap: 0.5rem;
                    align-items: center;
                }
                .pagination-page {
                    font-size: 0.85rem;
                    padding: 0 0.25rem;
                }
                .skill-row-text {
                    flex: 1;
                    min-width: 0;
                }
                .skill-row-name {
                    color: var(--text);
                    text-decoration: none;
                }
                .skill-row-name:hover {
                    color: var(--accent);
                }
                .skill-excerpt {
                    font-size: 0.85rem;
                    margin: 0.25rem 0;
                    overflow: hidden;
                    text-overflow: ellipsis;
                    white-space: nowrap;
                }
                .skill-meta {
                    font-size: 0.75rem;
                }
                .skill-errors {
                    margin: 0;
                    padding-left: 1.25rem;
                }
                .chat-skills {
                    position: relative;
                }
                .chat-skills-count {
                    margin-left: 0.25rem;
                    color: var(--text-muted);
                    font-weight: 500;
                }
                .chat-skills-panel {
                    position: absolute;
                    top: calc(100% + 0.375rem);
                    right: 0;
                    z-index: 20;
                    width: 18rem;
                    max-height: 22rem;
                    overflow-y: auto;
                    background: var(--surface);
                    border: 1px solid var(--border);
                    border-radius: 8px;
                    padding: 0.75rem;
                    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
                }
                .chat-skills-help {
                    font-size: 0.75rem;
                    margin: 0 0 0.5rem 0;
                }
                .chat-skill-row {
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                    padding: 0.375rem 0.25rem;
                    border-radius: 6px;
                    cursor: pointer;
                }
                .chat-skill-row:hover {
                    background: var(--border-light);
                }
                .chat-skill-row input[type="checkbox"] {
                    margin: 0;
                }
                .chat-skill-name {
                    font-size: 0.875rem;
                }
                .chat-skills-footer {
                    margin-top: 0.5rem;
                    padding-top: 0.5rem;
                    border-top: 1px solid var(--border);
                    font-size: 0.75rem;
                }
                .chat-card {
                    padding: 0;
                    overflow: hidden;
                    display: flex;
                    flex-direction: column;
                }
                .chat-card .chat-messages {
                    max-height: 60vh;
                    min-height: 200px;
                }
                .chat-card .chat-header {
                    padding: 0.75rem 1rem;
                    background: var(--border-light);
                }
                @media (max-width: 720px) {
                    .chat-grid { grid-template-columns: 1fr; height: auto; }
                    .chat-sidebar { max-height: 220px; }
                }
            </style>
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% if app.user %}
        <nav class="navbar">
            <a href="{{ path('app_recording_index') }}" class="brand">Braindump</a>
            <div class="nav-links">
                <a href="{{ path('app_recording_index') }}">Recordings</a>
                <a href="{{ path('app_recording_new') }}">New</a>
                <a href="{{ path('app_skill_index') }}">Skills</a>
                <a href="{{ path('app_user_settings') }}">Settings</a>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin') }}">Admin</a>
                {% endif %}
                <a href="{{ path('app_logout') }}" class="nav-muted">Logout</a>
                <button class="theme-toggle" role="switch" aria-checked="false" aria-label="Toggle dark mode">
                    <span class="knob">
                        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                    </span>
                </button>
            </div>
        </nav>
        {% else %}
        <script>
        (function(){
            var root=document.documentElement;
            var stored=localStorage.getItem('theme');
            var prefersDark=window.matchMedia('(prefers-color-scheme:dark)').matches;
            if(stored==='dark'||((!stored)&&prefersDark)){root.setAttribute('data-theme','dark')}
            else{root.setAttribute('data-theme','light')}
        })();
        </script>
        {% endif %}

        <div class="container">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </div>

        <script>
        (function(){
            var toggle=document.querySelector('.theme-toggle');
            if(!toggle)return;
            var root=document.documentElement;
            var sun=toggle.querySelector('.icon-sun');
            var moon=toggle.querySelector('.icon-moon');
            var stored=localStorage.getItem('theme');
            var prefersDark=window.matchMedia('(prefers-color-scheme:dark)').matches;
            var dark=stored?stored==='dark':prefersDark;

            function apply(d){
                dark=d;
                root.setAttribute('data-theme',d?'dark':'light');
                toggle.setAttribute('aria-checked',String(d));
                sun.style.display=d?'none':'block';
                moon.style.display=d?'block':'none';
            }

            apply(dark);

            toggle.addEventListener('click',function(){
                apply(!dark);
                localStorage.setItem('theme',dark?'dark':'light');
            });

            window.matchMedia('(prefers-color-scheme:dark)').addEventListener('change',function(e){
                if(!localStorage.getItem('theme')){apply(e.matches)}
            });
        })();
        </script>
    </body>
</html>

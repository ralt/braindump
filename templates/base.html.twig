<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Braindump{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🧠</text></svg>">
        {% block stylesheets %}
            <style>
                *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
                body {
                    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                    background: #fff;
                    color: #111;
                    line-height: 1.5;
                    -webkit-font-smoothing: antialiased;
                }

                /* Navbar */
                .navbar {
                    position: sticky;
                    top: 0;
                    z-index: 100;
                    background: #fff;
                    border-bottom: 1px solid #e5e7eb;
                    padding: 0 1.5rem;
                    height: 56px;
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                }
                .navbar a { color: #6b7280; text-decoration: none; font-size: 0.875rem; font-weight: 500; transition: color 0.15s; }
                .navbar a:hover { color: #111; }
                .navbar .brand { color: #111; font-weight: 700; font-size: 1.125rem; letter-spacing: -0.025em; }
                .navbar .nav-links { display: flex; gap: 1.25rem; align-items: center; }

                .container { max-width: 960px; margin: 0 auto; padding: 2rem 1.5rem; }

                /* Buttons */
                .btn {
                    display: inline-flex;
                    align-items: center;
                    padding: 0.5rem 1rem;
                    border: none;
                    border-radius: 8px;
                    cursor: pointer;
                    font-size: 0.875rem;
                    font-weight: 500;
                    text-decoration: none;
                    transition: all 0.15s;
                }
                .btn-primary { background: #4361ee; color: #fff; }
                .btn-primary:hover { background: #3651d4; box-shadow: 0 1px 3px rgba(67,97,238,0.3); }
                .btn-danger { background: #fff; color: #ef4444; border: 1px solid #fecaca; }
                .btn-danger:hover { background: #fef2f2; }
                .btn-secondary { background: #f3f4f6; color: #374151; }
                .btn-secondary:hover { background: #e5e7eb; }
                .btn-sm { padding: 0.325rem 0.75rem; font-size: 0.8rem; }

                /* Cards */
                .card {
                    background: #fff;
                    border: 1px solid #e5e7eb;
                    border-radius: 12px;
                    padding: 1.5rem;
                    margin-bottom: 1rem;
                }

                /* Forms */
                .form-group { margin-bottom: 1rem; }
                .form-group label { display: block; margin-bottom: 0.375rem; font-weight: 500; font-size: 0.875rem; color: #374151; }
                .form-group input, .form-group select, .form-group textarea {
                    width: 100%;
                    padding: 0.5rem 0.75rem;
                    border: 1px solid #d1d5db;
                    border-radius: 8px;
                    font-size: 0.875rem;
                    color: #111;
                    background: #fff;
                    transition: border-color 0.15s;
                }
                .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
                    outline: none;
                    border-color: #4361ee;
                    box-shadow: 0 0 0 3px rgba(67,97,238,0.1);
                }

                /* Alerts */
                .alert { padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1rem; font-size: 0.875rem; }
                .alert-error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
                .alert-success { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }

                /* Badges */
                .badge { display: inline-flex; align-items: center; padding: 0.2rem 0.625rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 500; }
                .badge-pending { background: #fef9c3; color: #854d0e; }
                .badge-transcribing { background: #dbeafe; color: #1e40af; }
                .badge-completed { background: #dcfce7; color: #166534; }
                .badge-failed { background: #fef2f2; color: #991b1b; }

                /* Tables */
                table { width: 100%; border-collapse: collapse; }
                table th, table td { padding: 0.75rem 1rem; text-align: left; }
                table th { font-weight: 500; font-size: 0.8rem; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid #e5e7eb; }
                table td { border-bottom: 1px solid #f3f4f6; font-size: 0.875rem; }
                table tbody tr:hover { background: #f9fafb; }
                table td a { color: #4361ee; text-decoration: none; font-weight: 500; }
                table td a:hover { color: #3651d4; }

                /* Page headings */
                h1 { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.025em; color: #111; }
                h2 { font-size: 1.125rem; font-weight: 600; color: #111; }
                h3 { font-size: 1rem; font-weight: 600; color: #111; }

                /* Alerts (continued) */
                .alert-warning { background: #fef9c3; color: #854d0e; border: 1px solid #fde68a; }
                .alert-warning-urgent { background: #ffedd5; color: #9a3412; border: 1px solid #fdba74; }

                /* Utilities */
                .flex { display: flex; }
                .flex-between { justify-content: space-between; }
                .flex-center { align-items: center; }
                .flex-wrap { flex-wrap: wrap; }
                .gap-1 { gap: 0.5rem; }
                .gap-separator { color: #d1d5db; }
                .mb-1 { margin-bottom: 1rem; }
                .mb-2 { margin-bottom: 1.5rem; }
                .mt-1 { margin-top: 1rem; }
                .text-muted { color: #6b7280; font-size: 0.875rem; }
                .text-center { text-align: center; }
                .text-success { color: #166534; font-size: 0.8rem; }
                .p-0 { padding: 0; }
                .p-section { padding: 3rem 1.5rem; }
                .overflow-hidden { overflow: hidden; }
                .w-full { width: 100%; }
                .justify-center { justify-content: center; }
                .inline { display: inline; }
                .hidden { display: none; }

                /* Layout components */
                .login-wrapper { max-width: 380px; margin: 6rem auto; }
                .login-header { text-align: center; margin-bottom: 2rem; }
                .login-header h1 { font-size: 1.75rem; }
                .empty-state { text-align: center; padding: 3rem 1.5rem; }
                .card-flush { padding: 0; overflow: hidden; }
                .card-section { padding: 1.5rem 1.5rem 0; }
                .input-inline {
                    flex: 1;
                    padding: 0.5rem 0.75rem;
                    border: 1px solid #d1d5db;
                    border-radius: 8px;
                    font-size: 0.875rem;
                    color: #111;
                    background: #fff;
                }
                .input-inline:focus {
                    outline: none;
                    border-color: #4361ee;
                    box-shadow: 0 0 0 3px rgba(67,97,238,0.1);
                }
                .select-inline {
                    padding: 0.5rem 0.75rem;
                    border: 1px solid #d1d5db;
                    border-radius: 8px;
                    font-size: 0.875rem;
                }
                .nav-muted { color: #9ca3af; }
                .meta-info { font-size: 0.875rem; color: #6b7280; }
                .transcription-text { white-space: pre-wrap; line-height: 1.7; font-size: 0.9375rem; color: #374151; }

                /* Waveform */
                .waveform-canvas {
                    width: 100%;
                    height: 80px;
                    border-radius: 8px;
                    background: #f9fafb;
                    margin-bottom: 1rem;
                }
            </style>
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% if app.user %}
        <nav class="navbar">
            <a href="{{ path('app_recording_index') }}" class="brand">Braindump</a>
            <div class="nav-links">
                <a href="{{ path('app_recording_index') }}">Recordings</a>
                <a href="{{ path('app_recording_new') }}">New</a>
                <a href="{{ path('app_user_settings') }}">Settings</a>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin') }}">Admin</a>
                {% endif %}
                <a href="{{ path('app_logout') }}" class="nav-muted">Logout</a>
            </div>
        </nav>
        {% endif %}

        <div class="container">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </div>
    </body>
</html>
